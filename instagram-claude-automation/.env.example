# Instagram Graph API credentials
# Get your IG_USER_ID by calling: GET /me?fields=instagram_business_account
# with your Page Access Token.
IG_USER_ID=your_instagram_business_account_id
ACCESS_TOKEN=your_long_lived_access_token

# Facebook App credentials (for token refresh)
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret

# Anthropic API key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Instagram Graph API version (latest stable as of 2026)
IG_API_VERSION=v22.0

# Optional: set to "true" to enable mock/dry-run mode (no real API calls)
MOCK_MODE=false

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Upload server API key (auto-generated if not set)
# UPLOAD_API_KEY=your_chosen_api_key
