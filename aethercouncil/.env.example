# AetherCouncil environment configuration
# Copy this to .env and fill in your actual keys
# IMPORTANT: NEVER commit .env to git; add to .gitignore

# OpenRouter API (required for agent deliberation)
# Get key at https://openrouter.ai/account/api_keys
# Rotate the key if it's been exposed (check GitHub, transcripts, logs)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Finnhub API (optional; fallback to free tier with rate limits)
# Get key at https://finnhub.io (free tier available)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpaca (paper trading; required for order execution)
# Get keys at https://app.alpaca.markets (use paper account)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# xAI (OPTIONAL) — enables the daily scout to scan ALL of X/Twitter natively
# via Grok's x_search. Without it the scout falls back to OpenRouter web search.
# Get key at https://console.x.ai
XAI_API_KEY=

# Execution and modes
PAPER_EXECUTE=0                     # set to 1 to actually place paper orders
TRADING_MODE=paper                  # paper | live (live requires LIVE_CONFIRM)
LIVE_CONFIRM=                       # set to "I_UNDERSTAND_THE_RISK" for live trading
START_EQUITY=10000                  # starting capital for risk sizing

# Trading loop tuning
LOOP_INTERVAL=60                    # seconds between trading cycle checks
REPORT_HOUR=20                      # ET hour for nightly green/red board report
SIGNAL_COOLDOWN=900                 # min sec between deliberations per symbol
DAILY_TOKEN_BUDGET=2.00             # max $ per day on trading LLM tokens
ENABLE_SHORTS=1                     # short overextended names (RSI rollover)
# WATCHLIST=NVDA,AMD               # override; default = FULL universe (~119)

# Daily research scout (scans X/web for new models/strategies/tools/catalysts)
SCOUT_ENABLED=1                     # 0 to disable the daily scout inside run_loop
SCOUT_HOUR=7                        # ET hour to run the daily scan
SCOUT_BUDGET=0.25                   # soft $ cap per scan (~$0.03 typical, web mode)
# SCOUT_SCANNER_MODEL=openai/gpt-4o-mini
# SCOUT_CURATOR_MODEL=deepseek/deepseek-v4-flash

# Paper track record / live gate (proof of edge before real money)
TARGET_R=2.0                        # take-profit at 2x the per-trade risk
MAX_HOLD_DAYS=5                     # time-stop for paper positions
MIN_TRADES_FOR_GATE=20             # closed trades required before live is even considered
LIVE_BRIER_MAX=0.24                # max Brier score to clear the live gate

# Notifications (optional). Pick ONE; falls back to console if none set.
# Telegram (easiest phone push): message @BotFather to make a bot, then get chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# NOTIFY_CHANNEL=telegram          # force a channel: telegram | email | console

# Parameter self-tuning (weekly, out-of-sample gated — never adopts overfit params)
TUNE_ENABLED=1
TUNE_DAY=6                        # weekday to auto-tune (0=Mon .. 6=Sun)
TUNE_TIMEFRAME=1h                # hourly bars have ~10x the signal of free daily
# TUNE_SYMBOLS=NVDA,AMD,RKLB,ASTS,TSLA,PLTR,MU,AVGO,ARM,SMCI,META,AMZN
# Tuned params are written to params.json and read live via params.py; they
# override these RSI/stop defaults once validated out of sample:
# RSI_OVERSOLD=30
# RSI_OVERBOUGHT=70
# STOP_ATR_MULT=1.5
# MAX_HOLD_DAYS=5
# TARGET_R=2.0

# Sub-agents (agents can build/manage their own specialists, hard-bounded)
SUBAGENT_MAX_DEPTH=2               # levels of sub-agents (prevents runaway recursion)
SUBAGENT_MAX_FANOUT=4             # max specialists spawned per level
SUBAGENT_BUDGET=0.15              # USD hard cap across the whole spawn tree
# SUBAGENT_LEAD=deepseek/deepseek-v4-flash   # lead/synthesis model (cheap default)

# --- Model roster (override any slug without touching code) ------------------
# Verified live prices per 1M tokens (in/out). Swap a slug here when the daily
# scout finds something genuinely better/cheaper — no code change needed.
# SWARM (cheap breadth; runs every deliberation):
# OR_DEEPSEEK=deepseek/deepseek-v4-flash            # $0.098 / $0.196  (current)
# OR_GLM=z-ai/glm-4.7-flash                         # $0.060 / $0.400
# OR_MINIMAX=minimax/minimax-m2.5                   # $0.120 / $0.480  (M3 costs 2.5x for 1M ctx we don't use)
# OR_QWEN=qwen/qwen3-30b-a3b-instruct-2507          # $0.048 / $0.193  (cheapest)
# COUNCIL (quality tier; only fires when gated):
# OR_CLAUDE=anthropic/claude-sonnet-5
# OR_GROK=x-ai/grok-4.3
# OR_GEMINI=google/gemini-3.1-flash-lite
# Experiment: point any council slot at OpenRouter's meta-router to A/B test it.
# Note: openrouter/fusion has DYNAMIC (opaque) pricing — budget can't be predicted,
# so it's off by default. Try e.g.  OR_GEMINI=openrouter/fusion  to compare.

VERBOSE=0                          # set to 1 for extra logging
