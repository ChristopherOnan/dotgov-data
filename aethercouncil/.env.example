# AetherCouncil environment configuration
# Copy this to .env and fill in your actual keys
# IMPORTANT: NEVER commit .env to git; add to .gitignore

# OpenRouter API (required for agent deliberation)
# Get key at https://openrouter.ai/account/api_keys
# Rotate the key if it's been exposed (check GitHub, transcripts, logs)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Finnhub API (optional; fallback to free tier with rate limits)
# Get key at https://finnhub.io (free tier available)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpaca (paper trading; required for order execution)
# Get keys at https://app.alpaca.markets (use paper account)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Execution and modes
PAPER_EXECUTE=0                     # set to 1 to actually place paper orders
TRADING_MODE=paper                  # paper | live (live requires LIVE_CONFIRM)
LIVE_CONFIRM=                       # set to "I_UNDERSTAND_THE_RISK" for live trading
START_EQUITY=10000                  # starting capital for risk sizing

# Tuning
LOOP_INTERVAL=60                    # seconds between trading cycle checks
REPORT_HOUR=20                      # ET hour for nightly green/red board report
SIGNAL_COOLDOWN=900                 # min seconds between trades on same symbol
DAILY_TOKEN_BUDGET=2.00             # max $ per day on LLM tokens

# Advanced
SIGNAL_COOLDOWN=900
VERBOSE=0                           # set to 1 for extra logging
